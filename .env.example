# ==============================================================================
# RAG Ingestion Coordinator - Environment Configuration Example
# ==============================================================================
# NOTICE:
#   - `.env` is strictly for LOCAL DEVELOPMENT ONLY. Changes to `.env` will NOT
#     affect deployments, Helm charts, or Kubernetes Pod specifications.
#   - `.env.prod` is the SINGLE SOURCE OF TRUTH for deployments. Only changes to
#     `.env.prod` affect `deployments/helm/values.yaml` and ConfigMaps.
#   - To synchronize configuration from `.env.prod` to Helm deployment values, run:
#         python scripts/sync_env_to_deployments.py --sync
#   - To verify zero configuration drift without modifying files, run:
#         python scripts/sync_env_to_deployments.py --check-only
#   - Pre-commit hooks enforce that `deployments/helm/values.yaml` is in sync
#     with `.env.prod` before any git commit is accepted.
#
# LOCAL USAGE:
#   - Copy this file to `.env` for local development. Both `cmd/coordinator` and
#     `workers/python/rag_document_ai_worker` load `.env` on startup.
#   - Variables already set in the shell or container environment take precedence.
#
# SECURITY:
#   - Never commit `.env`, `.env.prod`, or real credentials to version control.
#   - Credentials (PASSWORDS, SECRETS, TOKENS, KEYS) are automatically excluded
#     from `values.yaml` and must be injected via Kubernetes Secrets.
# ==============================================================================

# Optional path override for the dotenv file loaded at startup.
# ENV_FILE=.env

# ------------------------------------------------------------------------------
# Control Plane Server & Observability
# ------------------------------------------------------------------------------
# Structured JSON log level: debug | info | warn | error
LOG_LEVEL=info
# HTTP REST + /healthz + /ready + /metrics listen address
HTTP_ADDR=:8080
# Internal gRPC CoordinatorService listen address
GRPC_ADDR=:50051
# Graceful rolling/canary drain window before closing listeners on SIGINT/SIGTERM
SHUTDOWN_DRAIN_DELAY=5s
# Path to OpenAPI 3.1 specification served on GET /openapi.yaml
OPENAPI_SPEC_PATH=api/openapi/openapi.yaml

# ------------------------------------------------------------------------------
# Authentication & Tenant Isolation (HTTP REST & gRPC)
# ------------------------------------------------------------------------------
# Production HS256 JWT signing secret. When both AUTH_HMAC_SECRET and
# AUTH_STATIC_TOKENS_JSON are empty, authentication defaults to fail-closed.
AUTH_HMAC_SECRET=replace-with-local-dev-hmac-secret-at-least-32-chars
# Optional static Bearer token map (used only when AUTH_HMAC_SECRET is empty):
# AUTH_STATIC_TOKENS_JSON={"dev-write-token":{"tenant_id":"tenant-corp-01","scopes":["ingest:write","ingest:read"]}}

# ------------------------------------------------------------------------------
# PostgreSQL (Terminal Pipeline Runs & Pipeline Configs - ADR-003)
# ------------------------------------------------------------------------------
# Required connection string (PgBouncer transaction-pooling compatible)
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/rag_coordinator?sslmode=disable
# SSL mode applied when not embedded in POSTGRES_DSN (disable | allow | prefer | require | verify-ca | verify-full)
POSTGRES_SSLMODE=disable
# Connection pool bounds per coordinator pod
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
# Automatically apply embedded SQL migrations on startup (use `-migrate` job in production)
AUTO_MIGRATE=false

# ------------------------------------------------------------------------------
# Redis (Real-Time Pub/Sub Telemetry - ADR-004)
# ------------------------------------------------------------------------------
# Headless in-cluster addresses for production Bitnami Redis 7.2 Cluster (takes precedence over REDIS_ADDRS when set)
REDIS_CLUSTER_ADDRS=rag-ingestion-coordinator-redis-0.rag-ingestion-coordinator-redis-headless.rag-system.svc.cluster.local:6379,rag-ingestion-coordinator-redis-1.rag-ingestion-coordinator-redis-headless.rag-system.svc.cluster.local:6379,rag-ingestion-coordinator-redis-2.rag-ingestion-coordinator-redis-headless.rag-system.svc.cluster.local:6379
# Comma-separated Redis addresses (local standalone fallback, Sentinel, or Cluster seeds)
REDIS_ADDRS=localhost:6379
# Sentinel master set name (leave empty for Standalone / Cluster)
REDIS_MASTER_NAME=
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS_ENABLED=false

# ------------------------------------------------------------------------------
# Temporal Workflow Orchestration & Polyglot Workers
# ------------------------------------------------------------------------------
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
# Task queue polled by the Python Document AI worker
TEMPORAL_TASK_QUEUE=doc-ai-task-queue
# Enable embedded inspection-queue activity worker inside the coordinator process
ENABLE_INSPECTION_WORKER=false

# ------------------------------------------------------------------------------
# AWS S3 / S3-Compatible Object Storage (Presigned URLs & Byte-Range Reads)
# ------------------------------------------------------------------------------
S3_REGION=us-east-1
S3_BUCKET=rag-ingestion-bucket
# Optional custom endpoint for LocalStack / MinIO (leave empty for AWS S3)
S3_ENDPOINT=
# Set true for path-style addressing (required by MinIO / LocalStack)
S3_USE_PATH_STYLE=false
# Enable Runbook 2 hash-prefixed S3 artifact keys to mitigate HTTP 503 SlowDown
USE_HASH_PREFIX_S3_LAYOUT=false
# Static AWS credentials for local dev (leave empty in EKS/GKE to use IRSA / IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

